# MongoDB Atlas connection string
MONGO_URI=mongodb+srv://<user>:<password>@<cluster-url>/cartruckloans?retryWrites=true&w=majority

# Long random string used to sign admin login tokens
JWT_SECRET=change_this_to_a_long_random_string

# Port the API runs on locally (Render sets this automatically in production)
PORT=5001

# Comma-separated list of frontend URLs allowed to call this API
CLIENT_ORIGIN=http://localhost:5173

# Admin account created by the seed script (change before running in production)
SEED_ADMIN_EMAIL=admin@cartruckloans.ca
SEED_ADMIN_PASSWORD=change_this_password
